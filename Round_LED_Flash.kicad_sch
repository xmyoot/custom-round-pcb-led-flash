(text "01 / 3.3 V BUCK-BOOST - 500 mA minimum design target" (at 25 25 0) (effects (font (size 2 2)) (justify left)) (uuid "5eb2715a-b182-56f5-8cbb-67999c6e1199"))
(text "Draft: exact inductor suffix, capacitor MPNs and loop layout still require verification." (at 25 165 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "1f6ea20d-99fb-5b5e-baa5-69f1b854fee2"))
(text "02 / BLE CONTROLLER + UART PROGRAMMING" (at 285 25 0) (effects (font (size 2 2)) (justify left)) (uuid "73292ce0-258b-55d4-9ac0-fd47e0fd7eeb"))
(text "GPIO2 high for boot, then TRIG_REQ output LOW before ARM. GPIO7 reads TRIGGER_ALLOWED." (at 285 165 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "0fd00089-d64f-5921-89f0-2b0d5d3a97f6"))
(text "03 / 2.5 F EFFECTIVE CAP BANK - regulated 4.8 V" (at 545 25 0) (effects (font (size 2 2)) (justify left)) (uuid "d2929d1f-06ae-5344-9f4c-8570031b7488"))
(text "Two series cells; midpoint connects to LTC3225 CX. No bleed balancing resistors." (at 545 145 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "35b63a4e-b407-5239-934e-e59481a2d244"))
(text "Nominal stored energy 28.8 J. Fused boost branch, timed output cutoff and default-on discharge." (at 545 165 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "c89eeb07-7495-5356-9ad3-435a14971c21"))
(text "04 / SHUTTER, INDICATORS, LED-AREA NTC" (at 25 205 0) (effects (font (size 2 2)) (justify left)) (uuid "3ead0fb8-fff2-5c56-b7e7-cf7fd2ea6935"))
(text "D1 indicates battery charging; D2 BLE; D3 firmware flash-ready. TH1 senses LED-area temperature." (at 25 365 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "f1c63db4-f345-53ce-bd09-8998bb7f9529"))
(text "05 / CONNECTORS + 3.3 V UART POGO ACCESS" (at 285 205 0) (effects (font (size 2 2)) (justify left)) (uuid "974ed3c4-b979-55e1-85f7-213a70a5ee24"))
(text "07 / ADC POWER-OFF ISOLATION - enabled by regulator PG" (at 545 350 0) (effects (font (size 2 2)) (justify left)) (uuid "a7e81589-649e-5a4a-90a1-b15164725153"))
(text "TPS63070 PG is low with EN low; dividers discharge through their lower resistors." (at 545 425 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "42af29c8-423b-56ea-80dc-dbc35b64ecc6"))
(text "08 / 4.8 V SUPERCAP CHARGER + AUTOMATIC BALANCING" (at 25 415 0) (effects (font (size 2 2)) (justify left)) (uuid "07121a2a-d5a6-5121-9ee8-07cd8b4bf586"))
(text "Charge enabled by ARM; USB presence or timed flash window forces SHDN low." (at 25 570 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "6b4608c0-9fcc-5b73-9398-fb5f9e58ff2d"))
(text "09 / CELL FUSE + DW01 LOW-SIDE PROTECTION" (at 795 25 0) (effects (font (size 2 2)) (justify left)) (uuid "ec674932-82b1-5fcc-aba4-388a0453a683"))
(text "Raw negative is isolated from all USB, fixture and enclosure grounds." (at 795 155 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "bc4fcc3d-1a36-5bff-8445-26cab10a56b4"))
(text "10 / TYPE-C SOURCE QUALIFICATION - CHARGING ONLY" (at 795 195 0) (effects (font (size 2 2)) (justify left)) (uuid "c318ec1f-0a78-5d54-8bec-00f766a8d842"))
(text "Default-current and legacy USB sources do not charge this implementation." (at 795 395 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "df908773-0316-5629-aedc-2c31e1a22524"))
(text "11 / PROTECTED VBUS + 300 mA CELL CHARGER" (at 285 415 0) (effects (font (size 2 2)) (justify left)) (uuid "6551b8c6-d7de-5b28-979b-c2e8efe25df7"))
(text "Charging disables logic and cap recharge in hardware. Ground is protected pack negative." (at 285 605 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "98e1f198-22e3-5041-9aac-5abb2da38360"))
(text "12 / CELL NTC + SHORTED-SENSOR INHIBIT" (at 545 435 0) (effects (font (size 2 2)) (justify left)) (uuid "3084208e-650a-5d1e-81d4-a0b1a4265eed"))
(text "Open sensor inhibits through TP4056; short inhibits through U8. Check startup and thresholds." (at 545 605 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "ab90ff0a-2ebb-5d0f-a7d9-55a78059c41c"))
(text "13 / DEFAULT-ON CAPACITOR SERVICE DISCHARGE" (at 795 435 0) (effects (font (size 2 2)) (justify left)) (uuid "85a5fd9c-3a20-5e36-9edf-4805b4e0bf83"))
(text "Active dump removes most energy; permanent 330ohm bleed provides final discharge. Measure TP7 before service." (at 795 605 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "cb5a5c37-eaba-5371-a548-861f8fb0dd46"))
(text "14 / INDEPENDENT RAIL INTERLOCKS" (at 25 625 0) (effects (font (size 2 2)) (justify left)) (uuid "da3f2587-315a-52e7-9967-fabbb8eb1cdc"))
(text "Loaded-rail interlocks: cap ~3.39V rising / 3.15V falling; boost ~19.67V / 19.20V." (at 25 805 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "8bc5017d-3835-5a32-a4d6-b56a6f4c115d"))
(text "15 / NON-RETRIGGERABLE PULSE + COOLDOWN" (at 285 625 0) (effects (font (size 2 2)) (justify left)) (uuid "d1ee8f5f-201c-5853-89db-824315b98546"))
(text "U40: 1.403ms nominal maximum window; U41: 1.258s lockout from each window start." (at 285 805 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "b28d1556-6b9f-5ede-8509-b3c6920a8b43"))
(text "16 / HARDWARE FLASH PERMISSION + CHANNEL GATING" (at 545 625 0) (effects (font (size 2 2)) (justify left)) (uuid "eba84bd3-0c4b-59b0-8c7f-a69e4d18be50"))
(text "17 / PHYSICAL LED POWER CUTOFF - DEFAULT OFF" (at 25 820 0) (effects (font (size 2 2)) (justify left)) (uuid "50a46a03-20d4-5bba-844f-44c711e863d6"))
(text "External COB: BXRV-TR-2765G-10A0-A-23, independent channels, bonded heat spreader." (at 25 970 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "ecfa8cb8-5b52-5857-8a09-43a78c0f3635"))
(text "19 / POWER-ON DELAY + Ioff UART ISOLATION" (at 795 820 0) (effects (font (size 2 2)) (justify left)) (uuid "51fde797-159c-5d37-af52-2d305380bc48"))
